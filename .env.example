NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" povolí verejnú registráciu na /register pre každého. Prázdne
# (dnešný stav) NEZNAMENÁ zavreté: registrácia beží NA POZVÁNKU, teda
# formulár si vypýta promo kód a bez platného nikoho nepustí. Kód zároveň
# určuje, ako dlho má tréner appku zadarmo — pozri docs/promo-kody.md.
REGISTRATION_ENABLED=
# Disciplína nasadenia: "tennis" (predvolené, aj keď je premenná prázdna)
# alebo "fitness". Určuje zamerania, kódy cvičení, trvania a to, či sa
# zaznamenáva charakter cvičenia — pozri lib/discipline.ts.
# JEDNO NASADENIE = JEDNA DISCIPLÍNA (tenis plaw.win, kondička
# fitness.plawsports.com), preto sa číta pri builde, nie za behu.
NEXT_PUBLIC_PLAW_DISCIPLINE=
