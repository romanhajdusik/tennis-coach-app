NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" povolí verejnú registráciu na /register pre každého. Prázdne
# (dnešný stav) NEZNAMENÁ zavreté: registrácia beží NA POZVÁNKU, teda
# formulár si vypýta promo kód a bez platného nikoho nepustí. Kód zároveň
# určuje, ako dlho má tréner appku zadarmo — pozri docs/promo-kody.md.
REGISTRATION_ENABLED=
# Disciplína nasadenia: "tennis" (predvolené, aj keď je premenná prázdna)
# alebo "fitness". Určuje zamerania, kódy cvičení, trvania a to, či sa
# zaznamenáva charakter cvičenia — pozri lib/discipline.ts.
# JEDNO NASADENIE = JEDNA DISCIPLÍNA (tenis plaw.win, kondička
# fitness.plawsports.com), preto sa číta pri builde, nie za behu.
NEXT_PUBLIC_PLAW_DISCIPLINE=
# --- Stripe (etapa 2, docs/stripe.md) ---
# Publikovateľný kľúč — beží v prehliadači, je verejný. Testovací má v názve
# "test"; ostrý pribudne až v deň spustenia (etapa 4).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Tajný kľúč — patrí VÝHRADNE serveru. Kto ho má, ovláda účet.
STRIPE_SECRET_KEY=
# Podpisové tajomstvo webhooku. Webhook je verejná adresa bez prihlásenia,
# ktorá ZAPISUJE do databázy — bez overenia podpisu by si ktokoľvek nastavil
# "zaplatené". Dostaneš ho pri zakladaní webhooku v Stripe.
STRIPE_WEBHOOK_SECRET=
# `service_role` kľúč Supabase — obchádza RLS. Drží ho VÝHRADNE Stripe
# webhook (`lib/supabase/admin.ts`), lebo do `profiles` nesmie zapisovať ani
# prihlásený účet. NIKDY s prefixom NEXT_PUBLIC_ a nikdy v klientskom kóde.
SUPABASE_SERVICE_ROLE_KEY=
